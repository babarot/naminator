#!/usr/bin/env python3
"""A stand-in for exiftool in the demo: it speaks the -stay_open protocol
that go-exiftool uses, and answers each file with the shooting time listed
for its name in $MOCK_DATES ("name|YYYY:MM:DD HH:MM:SS|model" per line, the
camera model optional), after a
delay that varies by file, as reading a real photo does. A file not listed
has no shooting time, as a screenshot."""
import hashlib
import json
import os
import sys
import time

dates = {}
with open(os.environ["MOCK_DATES"]) as f:
    for line in f:
        name, date, *model = line.rstrip("\n").split("|")
        dates[name] = (date, model[0] if model else "")
delay = float(os.environ.get("MOCK_DELAY", "0.3"))

args = []
for line in sys.stdin:
    line = line.rstrip("\n")
    if line != "-execute":
        args.append(line)
        continue
    if "-stay_open" in args:
        # "-stay_open False": the caller is closing; exit at once as
        # exiftool does, rather than read "False" as a file
        break
    out = []
    for path in (a for a in args if not a.startswith("-")):
        name = os.path.basename(path)
        h = int(hashlib.md5(name.encode()).hexdigest(), 16)
        time.sleep(delay * (0.5 + (h % 100) / 100))
        info = {"SourceFile": path, "FileName": name}
        if name in dates:
            date, model = dates[name]
            info["DateTimeOriginal"] = date
            info["FileTypeExtension"] = os.path.splitext(name)[1][1:].lower()
            if model:
                info["Model"] = model
        out.append(info)
    sys.stdout.write(json.dumps(out) + "\n{ready}\n")
    sys.stdout.flush()
    args = []
